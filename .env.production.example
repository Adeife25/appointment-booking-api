# Production template. Copy to .env.production on the server, fill in real values,
# then `chmod 600 .env.production`. Never commit the filled-in copy.
#   cp .env.production.example .env.production

NODE_ENV=production
PORT=3001
SWAGGER_ENABLED=false
METRICS_ENABLED=false
RETURN_RESET_TOKEN=false
TRUST_PROXY=1

# Managed Postgres. Use the pooled connection string for DATABASE_URL and keep
# the direct one in DATABASE_DIRECT_URL if your provider gives you both.
DATABASE_URL=
# DATABASE_DIRECT_URL=
DATABASE_MAX_CONNECTIONS=10

# Managed Redis
REDIS_URL=redis://default:<password>@<host>:<port>

# Generate each independently: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated, no trailing slash. Must be the real frontend origins.
CORS_ORIGINS=https://app.example.com
PUBLIC_BASE_URL=https://api.example.com
CANCEL_WINDOW_HOURS=24
REMINDER_LEAD_HOURS=24

THROTTLE_TTL=60
THROTTLE_LIMIT=60
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=5
THROTTLE_PUBLIC_TTL=60
THROTTLE_PUBLIC_LIMIT=120

# Optional bootstrap admin. The seeder refuses to run without a password and
# rejects any value published in the repo. Generate with: openssl rand -base64 24
# Leave the whole block unset to skip seeding entirely.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Demo accounts must stay off in production.
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# Optional Google OAuth. Callback must match the Google console entry exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/v1/auth/google/callback

# Optional transactional email
RESEND_API_KEY=
RESEND_FROM=Appointment Booking <bookings@example.com>

# docker-compose.prod.yml only
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3001
GHCR_REPO=
IMAGE_TAG=latest