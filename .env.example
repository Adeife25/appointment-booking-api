DATABASE_URL=
# Maximum Postgres connections per API instance. Leave unset to use the
# pg default (10). Raise it when scaling to many replicas.
DATABASE_MAX_CONNECTIONS=10

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

PORT=3001

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

CANCEL_WINDOW_HOURS=24

CORS_ORIGINS=http://localhost:3001

THROTTLE_TTL=60
THROTTLE_LIMIT=60
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=5
THROTTLE_PUBLIC_TTL=60
THROTTLE_PUBLIC_LIMIT=120

REMINDER_LEAD_HOURS=24

REDIS_URL=redis://localhost:6379

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ADMIN_NAME=Admin

SWAGGER_ENABLED=true

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

PUBLIC_BASE_URL=http://localhost:3001

RESEND_API_KEY=
RESEND_FROM=Appointment Booking <onboarding@resend.dev>
RETURN_RESET_TOKEN=false

NODE_ENV=development
